# Porta HTTP da API
PORT=3000
# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=troque-este-segredo
# Validade do token
JWT_EXPIRES_IN=12h
# Arquivo JSON usado como banco de dados
DB_FILE=data/db.json
# Minutos de tolerância antes de uma medicação ser considerada atrasada
TOLERANCIA_ATRASO_MIN=30
